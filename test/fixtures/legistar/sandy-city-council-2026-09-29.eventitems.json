entItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":44379,"EventItemGuid":"2BF7BDE4-7F8A-439C-A14A-102A9AB7A6CD","EventItemLastModifiedUtc":"2026-09-30T22:52:09.533","EventItemRowVersion":"AAAAAAB15G4=","EventItemEventId":2090,"EventItemAgendaSequence":6,"EventItemMinutesSequence":3,"EventItemAgendaNumber":null,"EventItemVideo":106227,"EventItemVideoIndex":171,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\fs20 Council Chair Marci Houseman welcomed those in attendance.\\par\r\n\\par\r\nCouncil Member Brooke Christensen offered the Prayer.\\par\r\nCouncil led the Pledge.\\par\r\n\\par\r\nCouncil moved to Item 1 on the Agenda.\\par\r\n}\r\n","EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"Prayer, Pledge of Allegiance, and Introductions","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":44380,"EventItemGuid":"77933078-10AF-4849-A68C-2868B6780493","EventItemLastModifiedUtc":"2026-09-30T23:05:48.627","EventItemRowVersion":"AAAAAAB15Hg=","EventItemEventId":2090,"EventItemAgendaSequence":7,"EventItemMinutesSequence":4,"EventItemAgendaNumber":null,"EventItemVideo":106228,"EventItemVideoIndex":2145,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":"{\\rtf1\\ansi\\ansicpg1252\\deff0\\deflang1033{\\fonttbl{\\f0\\fnil\\fcharset0 Arial;}}\r\n{\\colortbl ;\\red0\\green0\\blue0;}\r\n\\viewkind4\\uc1\\pard\\cf1\\fs20 Council Chair Houseman invited the public to participate in general citizen comment.\\par\r\n\\par\r\nPublic comment opened.\\par\r\nCarol John expressed concerns about drivers speeding down city streets. She called the police department to schedule a speed board for her street and was told that there were only two in the city and they had been reserved for the next few months. She recommended the city get more of these speed boards.\\par\r\n\\par\r\nSteve Van Maren suggested that if any resident requests a rezone, they should correct the thing that does not meet our city code prior to requesting a rezone. Don't entertain a rezone if there is a problem.\\par\r\n\\par\r\nHenry Butters had questions for a council member. He also discussed an issue he had with dogs off leash.  \\par\r\n\\par\r\nCouncil convened a recess at 5:56 pm\\par\r\nCouncil reconvened at 6:00 PM and continued with General Citizen Comment.\\par\r\n\\par\r\nPublic comment closed.\\par\r\n\\par\r\nCouncil moved to Item 7 and convened a closed session.\\par\r\nCouncil Member Aaron Dekeyzer was excused from the meeting at 6:00 PM.\\par\r\n}\r\n","EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"General Citizen Comment Period (No earlier than 6:00 PM)","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":44381,"EventItemGuid":"03CB541E-C8F0-42A6-B843-44AD15D37D4B","EventItemLastModifiedUtc":"2026-09-30T22:39:46.373","EventItemRowVersion":"AAAAAAB1478=","EventItemEventId":2090,"EventItemAgendaSequence":8,"EventItemMinutesSequence":null,"EventItemAgendaNumber":null,"EventItemVideo":106232,"EventItemVideoIndex":null,"EventItemVersion":null,"EventItemAgendaNote":null,"EventItemMinutesNote":null,"EventItemActionId":null,"EventItemActionName":null,"EventItemActionText":null,"EventItemPassedFlag":null,"EventItemPassedFlagName":null,"EventItemRollCallFlag":0,"EventItemFlagExtra":0,"EventItemTitle":"The General Citizen Comment period is the time set aside for the public to comment on any City business, including any item listed on tonight's agenda. General Citizen Comment will begin no earlier than 6:00 PM.  Citizen comment will also be taken during each Council Voting Item and each Public Hearing Item for comments related to those items.\r\n\r\nEach speaker is allowed three minutes during each comment period.  A speaker may comment during multiple comment periods, so long as the topic of the comment is different each time. No speaker will be permitted to comment more than once during any individual comment period.\r\n\r\nSpeakers wishing to comment live should attend the meeting in person or access the meeting virtually via the Zoom Webinar link. The call-in number is generally for listening only. You may also leave a written comment by emailing CitizenComment@sandy.utah.gov.","EventItemTally":null,"EventItemAccelaRecordId":null,"EventItemConsent":0,"EventItemMoverId":null,"EventItemMover":null,"EventItemSeconderId":null,"EventItemSeconder":null,"EventItemMatterId":null,"EventItemMatterGuid":null,"EventItemMatterFile":null,"EventItemMatterName":null,"EventItemMatterType":null,"EventItemMatterStatus":null,"EventItemMatterAttachments":[]},{"EventItemId":44382,"EventItemGuid":"EC598275-B0AF-4C95-A2F1-679A46ED00BE","EventItemLastModifiedUtc":"2026-09-30T22:39:51.927","EventItemRowVersion":"AAAAAAB15AQ=","EventItemEventId":2090,"EventItemAgendaSequence":9,"EventItemMinutesSequen
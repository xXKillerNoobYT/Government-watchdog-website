# Government Watchdog website — local environment template.
# Copy to `.env` for local runs. Reviewer-internal/local ONLY — never point this
# at a public host (GOV-94 owner condition 2: no public exposure).

# When "true", the REVIEWER READ MODEL uses its labeled local capture instead of
# the read-API. This does not control account notifications.
VITE_USE_FIXTURES=false

# Base URL of the reviewer-internal read-API (GOV-98). The read-API is a local,
# read-only module that emits web-safe JSON; when a local HTTP shim exposes it,
# put its localhost URL here and set VITE_USE_FIXTURES=false.
# Example: http://127.0.0.1:8787/read
VITE_READ_API_URL=

# Reviewer / local bypass (GOV-419). When "true", the gated-beta preview lets you
# open the full reviewer-internal app (timeline / cards / matrix) for a local
# walkthrough or screenshots WITHOUT shipping public access. Leave empty/false for
# the default preview-launch behaviour (the full app stays behind the gate).
# Local-only: this build is reviewer-internal + noindex; never set on a public host.
VITE_REVIEWER_BYPASS=

# --- GOV-1527 (Phase 1c) build integration -----------------------------------
# Same-origin API base (§5). The browser talks ONLY to this origin; the hosting
# layer forwards /api/* to the loopback auth/notification service. Leave as the
# default unless you have a reason to change the mount point. Absolute/cross-origin
# values are ignored (same-origin contract).
VITE_API_BASE=/api
# To consume the gated lane from the local service, point the read model at the
# same-origin route and turn fixtures off:
#   VITE_READ_API_URL=/api/reviewer-internal
#   VITE_USE_FIXTURES=false

# Development-server-only account notification examples. Vite production builds
# ignore this switch even if it is present. The live endpoint is always the
# same-origin `${VITE_API_BASE}/notifications`; no absolute URL override exists.
VITE_NOTIFICATIONS_DEMO=false

# LANDING_ONLY fail-closed flag (§6). When "1"/"true", the app ships the public
# landing + waitlist with ZERO /api surface — an explicit choice, never an
# automatic degrade. The build-side counterpart is `LANDING_ONLY=1` for
# scripts/fetch-artifact.mjs.
VITE_LANDING_ONLY=

# --- Build/e2e-only (read by scripts/*, NOT client `VITE_` vars) -------------
# BACKEND_REF pin lives in the repo-root ./BACKEND_REF file (a 40-char SHA or a
# tag). Override for a local build with a checkout path:
#   BACKEND_REF=local:/path/to/Government-watchdog
# Hosted download of the Release artifact needs a fine-grained, Contents:read PAT
# on the BACKEND repo only. NEVER commit it; it exists only as a hosting secret:
#   GW_BACKEND_DEPLOY_TOKEN=github_pat_xxx   (unset for local: builds)
# Loopback port the /api proxy forwards to (must match the running service):
#   GW_SERVICE_PORT=8791
